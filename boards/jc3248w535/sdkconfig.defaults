# Guition JC3248W535: ESP32-S3 (QFN56), 16 MB flash, 8 MB octal PSRAM in the chip, USB-Serial/JTAG
# only (docs/devices/JC3248W535).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_HC_BOARD_JC3248W535=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# esptool flash-id: manufacturer 0x68 (Boya), device 0x4018
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/16mb.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The only USB port is the chip's USB-Serial/JTAG, there is no USB-UART bridge
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL renders whole frames into PSRAM (hc::board::Info::full_frames): the largest data cache
# with 64 byte lines, as recommended by esp_lvgl_port's performance notes for the ESP32-S3
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# QSPI panel: RGB565 high byte first (hc::board::Info::swap_bytes). LVGL 8 only; with LVGL 9 this
# becomes esp_lvgl_port's swap_bytes flag.
CONFIG_LV_COLOR_16_SWAP=y

# A camera stream (components/hass/src/media.cpp) is read between the decoding of two frames: with
# the default window of 4 segments go2rtc stops sending while a frame decodes. 16 segments, within
# the 32 dynamic Wi-Fi receive buffers; the mailbox holds a window of them.
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
