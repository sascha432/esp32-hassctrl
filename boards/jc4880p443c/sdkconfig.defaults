# Guition JC4880P443C-I-W: ESP32-P4 (rev v3.2 on the first unit), 16 MB flash, 32 MB PSRAM in the
# chip, ESP32-C6 as the Wi-Fi radio over SDIO, USB-Serial/JTAG console (docs/devices/JC4880P443C).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_HC_BOARD_JC4880P443C=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# esptool flash-id: manufacturer 0x68 (Boya), device 0x4018
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/16mb.csv"
# The ESP32-P4 bootloader starts at 0x2000, so it has 24 KB before the partition table at 0x8000;
# with info logs it was 25 KB. Warnings only (the app logs chip, flash and PSRAM itself).
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# hex PSRAM at 200 MHz, as the vendor demo
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# The USB port labelled "USB2" is the chip's USB-Serial/JTAG (COM11)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# the larger fonts of this board (Info::ui_large_fonts, hc::ui::theme): 16, 18, 20, 26, 36
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_36=y

# Wi-Fi through the ESP32-C6 (esp_hosted + esp_wifi_remote, components/network): SDIO slot 1,
# 4 bit, the pins of Espressif's ESP32-P4 Function EV board, which this board copies (vendor demo
# sdkconfig: CMD 19, CLK 18, D0..D3 14..17, C6 reset on GPIO 54)
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

# A camera stream (components/hass/src/media.cpp) is read between the decoding of two frames: with
# the default window of 4 segments go2rtc stops sending while a frame decodes, and its 10 fps
# stream of 34 KB frames arrived at 3 fps (100 KB/s of the 338 sent). The segments wait in PSRAM
# (CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP); the mailbox holds a window of them.
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64

# LVGL rotates the landscape bands (800 x 30 lines) in pieces of this size and flushes each one: the
# default 10 KB took 6 lines, each piece landing in the portrait frame buffer as 800 rows of 12
# bytes; a whole band at once (47 KB, PSRAM) made a camera stream's 800x480 frame cost less
CONFIG_LV_DISP_ROT_MAX_BUF=49152
