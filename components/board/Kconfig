menu "hassctrl board"

    choice HC_BOARD
        prompt "Board"
        help
            The board the firmware is built for. Each board's sdkconfig.defaults in boards/<name>/
            selects it, see docs/architecture.md section 8.

        config HC_BOARD_WT32_SC01
            bool "Wireless-Tag WT32-SC01 (ESP32, 480x320 ST7796S, FT6336U touch)"
            depends on IDF_TARGET_ESP32
            select HC_BOARD_HAS_VIBRATION

        config HC_BOARD_TTGO_T4
            bool "LilyGO TTGO T4 v1.3 (ESP32, 320x240 ILI9341, no touch, test device only)"
            depends on IDF_TARGET_ESP32

        config HC_BOARD_JC3248W535
            bool "Guition JC3248W535 (ESP32-S3, 320x480 AXS15231B over QSPI, integrated touch)"
            depends on IDF_TARGET_ESP32S3
            select HC_BOARD_HAS_AUDIO

        config HC_BOARD_JC4880P443C
            bool "Guition JC4880P443C (ESP32-P4 + C6, 480x800 ST7701S over MIPI-DSI, GT911 touch)"
            depends on IDF_TARGET_ESP32P4
            select HC_BOARD_HAS_AUDIO
            select HC_BOARD_HAS_VIBRATION
            select HC_BOARD_HAS_CAMERA
            select HC_BOARD_HAS_MIC
            select HC_BOARD_HAS_SDCARD
    endchoice

    config HC_BOARD_HAS_AUDIO
        bool
        help
            The board has an I2S amplifier for a speaker (hc::board::Info::audio_*); it makes
            the audio component's options available (CONFIG_HC_AUDIO).

    config HC_BOARD_HAS_MIC
        bool
        help
            The board has a microphone behind its audio codec (hc::board::Info::audio_din_gpio);
            it makes the microphone option available (CONFIG_HC_MIC).

    config HC_BOARD_HAS_VIBRATION
        bool
        help
            The board has a vibration motor (hc::board::Info::vibration_gpio); it makes the
            vibration component's option available (CONFIG_HC_VIBRATION).

    config HC_BOARD_HAS_CAMERA
        bool
        help
            The board has a MIPI-CSI camera connector: the camera component, Settings, Camera with
            its preview, and the stream at /api/camera.jpg and /api/camera.mjpg.

    config HC_BOARD_HAS_SDCARD
        bool
        help
            The board has a microSD slot on the SDMMC host (hc::board::Info::sd_*); it makes the
            SD card option available (CONFIG_HC_SDCARD).

    config HC_BOARD_BRING_UP
        bool "Board bring-up: start with the test screen"
        default n
        help
            Only while a board is added (docs/adding-a-board.md): the main firmware starts with the
            display test screen (color bars, refresh times, touch, backlight calibration) over the
            start screen, until a dashboard is drawn. Set it in boards/<name>/sdkconfig.defaults
            and remove it again once the board's constants are in its board::Info; without it the
            test screen is not in the firmware.

endmenu
