# Main firmware layer (docs/architecture.md section 2).

# rendering speed over size, as recommended by esp_lvgl_port's performance notes
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms tick: esp_lvgl_port sleeps at least 5 ms between lv_timer_handler() calls, which is 0 ticks
# at 100 Hz; the LVGL task then only yields and starves IDLE0 (task watchdog) whenever its flush does
# not block, as on the P4's MIPI-DSI panel
CONFIG_FREERTOS_HZ=1000

# app_main starts everything: 3584 left 204 bytes and overflowed now and then into the heap (the
# interrupts save their frame on the task they interrupt). Freed when app_main returns.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# LVGL 8.4 (docs/architecture.md section 7.1)
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL allocates from PSRAM, internal RAM only when the PSRAM is full (main/lvgl/hc_lv_mem.h)
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="hc_lv_mem.h"
CONFIG_LV_DISP_DEF_REFR_PERIOD=10
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# the values of the dashboard tiles
CONFIG_LV_FONT_MONTSERRAT_28=y
# QR codes of the hotspot and the web UI address (Settings)
CONFIG_LV_USE_QRCODE=y
# LVGL warnings and LV_LOG_USER go to the ESP-IDF log (main.cpp)
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
# step 2 measurements (docs/architecture.md section 13)
CONFIG_LV_USE_PERF_MONITOR=y

# TLS (Home Assistant over wss://, update downloads) allocates from PSRAM: one connection costs
# about 40 KB, more than the WT32 has free in internal RAM (docs/ui/web.md section 9)
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Sending takes a lock of its own: the client's task holds its lock while it hands a message to
# hass (which waits up to 100 ms for room in the queue), and a send then waited up to 5 s while
# the queue filled (quick taps on the JC3248W535, "event dropped, the queue is full")
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y

# a camera tile's own stream with a login in its address (http://user:password@host/): the media
# task sets Basic auth for it (hass/src/media.cpp)
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=y
