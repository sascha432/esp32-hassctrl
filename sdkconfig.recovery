# Recovery app layer (docs/architecture.md section 9.5): small, nothing fancy.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The recovery app must start even when the PSRAM fails, otherwise a hardware fault ends in a
# boot loop with no way to update the device.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Static buffers in PSRAM (EXT_RAM_BSS_ATTR, sdkconfig.defaults) would undo that: ESP-IDF aborts the
# boot when the PSRAM they live in fails. Here they stay in internal RAM.
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set

# Size: the factory partition is 1 MB and the recovery app has Wi-Fi, the web server and the
# HTTPS download of update images. It downloads over TLS but never serves it (the web UI's HTTPS
# option is a main firmware feature), and it needs no IPv6.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_LWIP_IPV6 is not set

# Size: no WPA2/3 Enterprise (EAP, its TLS client) and no SAE-PK; the setup only has SSID and
# password. Plain WPA2 and WPA3 (SAE) stay.
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set

# No SD card in the recovery app (the main firmware's CONFIG_HC_SDCARD): the webserver requires the
# sdcard component, which would offer it here as well.
# CONFIG_HC_SDCARD is not set

# Size: none of the firmware's page APIs (Home Assistant, dashboard, backup, camera, player, time);
# the recovery app has none of them, and the time routes alone bring the time zone table and SNTP.
# CONFIG_HC_WEB_FIRMWARE_ROUTES is not set

# Size: a failed assert aborts with the backtrace but without its expression and file name
# (about 25 KB of strings).
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Size: no WebSocket in the recovery app (the web app's live socket, components/webserver/src/
# live.cpp); its pages ask for their state instead. The 1 MB factory partition is full.
# CONFIG_HTTPD_WS_SUPPORT is not set
# CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT is not set
